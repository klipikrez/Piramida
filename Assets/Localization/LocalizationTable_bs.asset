  m_TableData:
  - m_Id: 20027139002368
    m_Localized: "U\u010Ditava se, sacekaj malo, stoko!"
    m_Metadata:
      m_Items: []
  - m_Id: 26299045351424
    m_Localized: Odabeli stazu
    m_Metadata:
      m_Items: []
  - m_Id: 26539760652288
    m_Localized: "Pode\u0161avanja"
    m_Metadata:
      m_Items: []
  - m_Id: 26857353351168
    m_Localized: Izadji
    m_Metadata:
      m_Items: []
  - m_Id: 29245296447488
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 29398904442880
    m_Localized: Bosanska piramida
    m_Metadata:
      m_Items: []
  - m_Id: 31115389800448
    m_Localized: "Vrati me na po\u010Detni meni"
    m_Metadata:
      m_Items: []
  - m_Id: 34950736875520
    m_Localized: Nastavi
    m_Metadata:
      m_Items: []
  - m_Id: 396604921463541828
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Mi kasa su kasa, jk. mr\u0161
      napolje."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228083
  - m_Id: 396604921463541829
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Inace, trenutno dangubi\u0161
      u Kul Klimatizovanom Karavanskom Kanjonu u sred Dangubarske pustinje."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228084
  - m_Id: 396604921463541830
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u010Cim sam \u010Duo kako
      se zove, odma sam doleteo ovde."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228085
  - m_Id: 396604921463541831
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: I mora priznam..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228086
  - m_Id: 396604921463541832
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Vru\u0107e je..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228087
  - m_Id: 396604921463541833
    m_Localized: "Aj \u0107ao."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228088
  - m_Id: 396604921463541834
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Aaaaajde..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228089
  - m_Id: 396604921463541835
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ako se negde zaglavi\u0161,
      samo me nadji, bi\u0107u blizu (heh)."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228090
  - m_Id: 396604921463541836
    m_Localized: "Indijanac_D\u017Eons: ..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228091
  - m_Id: 396604921463541837
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Au, batice..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942227979
  - m_Id: 396604921463541838
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Au, batice..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228092
  - m_Id: 396604921463541839
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: A ba\u0161 sam ja hteo da je
      sma\u017Eem..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228093
  - m_Id: 396604921463541840
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Bra\u0107ala, vdi \u0161ta
      si uradio malenoj pti\u010Dici."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228094
  - m_Id: 396604921463541841
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Osta od pti\u010Dice saaaaamo
      krilca."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228095
  - m_Id: 396604921463541842
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: A'si lud!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228096
  - m_Id: 396604921463541843
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: ..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228097
  - m_Id: 396604921463541844
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Vau, ta sekir\u010Duga ti je
      jeeeeeezivo kul."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228098
  - m_Id: 396604921463541845
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Gledaj!!!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228099
  - m_Id: 396604921463541846
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: DINAMIT!!!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228100
  - m_Id: 396604921463541847
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: IDI GA LUPI!!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228101
  - m_Id: 396604921463541848
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ja sve ove godine nisam imo
      muda..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228102
  - m_Id: 396604921463541849
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Rekli su mi da je dinamit opasan
      po \u017Eivot..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228103
  - m_Id: 396604921463541850
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Pa probaj mo\u017Eda sa [smoothWave]veeeeeeeelike[/smoothWave]
      daljine da ga pogodi\u0161."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228104
  - m_Id: 396604921463541851
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Isto, ako o\u0107es da pokupis
      sekiru kad si je bacio, koristi\u0161 <sprite index=5>."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228105
  - m_Id: 396604921463541852
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Znaci, <sprite index=4>da je
      bacis, a <sprite index=5> da je pokupis."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228106
  - m_Id: 396604921463541853
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: A BATE!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942227995
  - m_Id: 396604921463541854
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: A BATE!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228107
  - m_Id: 396604921463541855
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: glup si za trojicu\u2026"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228108
  - m_Id: 396604921463541856
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: pribli\u017Ei se, molim te.
      Nemooogu da gleedam ovo!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228109
  - m_Id: 396604921463541857
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: De si kupio to u\u017Ee kad
      je toliko kratko?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228110
  - m_Id: 396604921463541858
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Kod \u0160ukse?!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228111
  - m_Id: 396604921463541859
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: BAHAahaha!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228112
  - m_Id: 396604921463541860
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u010Cuj, batice, ima jo\u0161
      jedna opaka stvar koju te sekirice obi\u010Dno mogu da urade."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228002
  - m_Id: 396604921463541861
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u010Cuj, batice, ima jo\u0161
      jedna opaka stvar koju te sekirice obi\u010Dno mogu da urade."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228113
  - m_Id: 396604921463541862
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Slu\u0161aj ovo!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228114
  - m_Id: 396604921463541863
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Mo\u017Ee\u0161 da je frkne\u0161
      na foru neke kuke za penjanje."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228115
  - m_Id: 396604921463541864
    m_Localized: "...a, \u0161ta je kuka za penjanje?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228116
  - m_Id: 396604921463541865
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \"GrapPlinG Hook\"."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228117
  - m_Id: 396604921463541866
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Vi mladi samo \u0160vajcarske
      izraze razumete, mater vam klo\u0161arsku!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228118
  - m_Id: 396604921463541867
    m_Localized: ok..?
    m_Metadata:
      m_Items:
      - rid: 8448310131942228119
  - m_Id: 396604921463541868
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Kad ti se sekira negde zabode..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228120
  - m_Id: 396604921463541869
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Samo svojim neuronima dr\u017Ei
      <sprite index=7> i <sprite index=5> u isto vreme."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228121
  - m_Id: 396604921463541870
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: I ALAH TI VERA, ima\u0161 {0}
      BATO!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228122
  - m_Id: 396604921463541871
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: aj sad se popenji ovde gore."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228123
  - m_Id: 396604921463541827
    m_Localized: Gde smo sad?
    m_Metadata:
      m_Items:
      - rid: 8448310131942228124
  - m_Id: 396604921463541826
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Aaaa? Sam seeeesi?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228125
  - m_Id: 396604921463541825
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ja mislim da mi ovako bolje
      stoji."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228126
  - m_Id: 396604921463541824
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Pa sam se malo obrijao."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228127
  - m_Id: 396604921463541823
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Bato... ova pustinjska vru\u0107in\u010Dina
      mi pomerila bulju..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228128
  - m_Id: 396604921463541822
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: NEMA!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228129
  - m_Id: 396604921463541821
    m_Localized: Gde ti je krzno?
    m_Metadata:
      m_Items:
      - rid: 8448310131942228130
  - m_Id: 396604921463541820
    m_Localized: Gde ti je krzno?
    m_Metadata:
      m_Items:
      - rid: 8448310131942228021
  - m_Id: 396604921463541819
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Nema veze."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228131
  - m_Id: 396604921463541818
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Bmk, vi\u0161e za mene. [smoothWave]mRRRRRRRnjau[/smoothWave]!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228132
  - m_Id: 396604921463541817
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Mamina pi\u0107kica ne sme
      da proba."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228133
  - m_Id: 396604921463541816
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: BAHAahaha!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228134
  - m_Id: 396604921463541815
    m_Localized: ne.
    m_Metadata:
      m_Items:
      - rid: 8448310131942228135
  - m_Id: 396604921463541814
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Au burazeru, pa ti si opako
      zveknuo tu tintaru..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228136
  - m_Id: 396604921463541813
    m_Localized: "ne nemam izvini stvarno mi je \u017Eao al da imam dao bi ti odma\u2026
      Ima\u0161 Upalja\u0107?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228137
  - m_Id: 396604921463541812
    m_Localized: "ne nemam izvini stvarno mi je \u017Eao al da imam dao bi ti odma."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228138
  - m_Id: 396604921463541811
    m_Localized: "ne nemam izvini stvarno mi je \u017Eao."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228139
  - m_Id: 396604921463541810
    m_Localized: ne nemam izvini.
    m_Metadata:
      m_Items:
      - rid: 8448310131942228140
  - m_Id: 396604921463541809
    m_Localized: ne nemam.
    m_Metadata:
      m_Items:
      - rid: 8448310131942228141
  - m_Id: 396604921463541808
    m_Localized: ne.
    m_Metadata:
      m_Items:
      - rid: 8448310131942228142
  - m_Id: 396604921463541807
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Znas kako je... (heh)."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228143
  - m_Id: 396604921463541806
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Moj se isprazni pa mora palim
      plugu sa fokusiranim zrakom svetlosti..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228144
  - m_Id: 396604921463541805
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ima\u0161 upalja\u010D mo\u017Eda?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228145
  - m_Id: 396604921463541804
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Al kad si ve\u0107 tu..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228146
  - m_Id: 396604921463541803
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ne nudim ti moju, Ako hvata\u0161
      moje frekvencije..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228147
  - m_Id: 396604921463541802
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Mo\u017Ee brato, al ono kao..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228148
  - m_Id: 396604921463541801
    m_Localized: Daj ajjjjde.
    m_Metadata:
      m_Items:
      - rid: 8448310131942228149
  - m_Id: 396604921463541800
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: B[smoothWave]uuuuuuuuuuu[/smoothWave]kvalno."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228150
  - m_Id: 396604921463541799
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Zna\u0161 batice, treba proba\u0161
      malo ove ma\u010Dije travice malenice, \u2018na\u010Di stvar ODVALJUJE!~"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228151
  - m_Id: 396604921463541798
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Jo\u0161 si tu jebote?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228152
  - m_Id: 396604921463541797
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Jo\u0161 si tu jebote?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228044
  - m_Id: 396604921463541796
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Samo svojim neuronima pritiskaj:
      <sprite index=0><sprite index=1><sprite index=2><sprite index=3>, i ska\u010De\u0161
      na <sprite index=6>."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228153
  - m_Id: 396604921463541795
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ako si zaboravio da hoda\u0161
      sa\u0107u da te podsetim!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228154
  - m_Id: 396604921463541794
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Daj malo aktiviraj te atrofirane
      mi\u0161i\u0107e..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228155
  - m_Id: 396604921463541793
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Peskom?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228156
  - m_Id: 396604921463541792
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Izgleda\u0161 mi \u017Egoljavo
      za jednog indijanca\u2026"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228157
  - m_Id: 396604921463541791
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: [smoothWave]mRRRRRRRRRnjau!!![/smoothWave]"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228158
  - m_Id: 396604921463541790
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Malo sam po\u010Deo da pumpam
      u trtani i pijem ovaj naturalni soki\u0107!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228159
  - m_Id: 396604921463541789
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Aaa, ma\u010Doru, el to merka\u0161
      moje mu\u017Eevne MA\u010CO mi\u0161i\u0107e?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228160
  - m_Id: 396604921463541788
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u0160ta je??"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228161
  - m_Id: 396604921463541787
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u0160ta me gleda\u0161 ko
      tele u \u0161arena vrata?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228162
  - m_Id: 396604921463541786
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Zr-Zar ne vidi\u0161 da radim
      ovde, V[smoothWave]aaaaaaaaa[/smoothWave]\u017Ean poso..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228163
  - m_Id: 396604921463541785
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ono kao drugar, \u0161ta se
      trezni\u0161 u-u mojoj rupetini, aa?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228164
  - m_Id: 396604921463541784
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ovde dole bato!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228165
  - m_Id: 396604921463541783
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: [normalWave]EeEeEeEeEeE!!![/normalWave]"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228166
  - m_Id: 396604921463541782
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Alo Kur\u010Davela!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228167
  - m_Id: 396604921463541781
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: *psst*"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228168
  - m_Id: 396604921463541780
    m_Localized: "Indijanac_D\u017Eons: ..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228169
  - m_Id: 396604921463541779
    m_Localized: "BOB: *Klikni <sprite index=6> da nastavi\u0161*"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228170
  - m_Id: 396604921463541778
    m_Localized: "BOB: *Klikni <sprite index=6> da nastavi\u0161*"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228063
  - m_Id: 396604921388044288
    m_Localized: 'BOB: aloo'
    m_Metadata:
      m_Items:
      - rid: 8448310131942228171
  - m_Id: 396604921463541777
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Samo svojim neuronima pritiskaj:
      <sprite index=0><sprite index=1><sprite index=2><sprite index=3>, i ska\u010De\u0161
      na <sprite index=6>."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228172
  - m_Id: 396604921463541776
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ako si zaboravio da hoda\u0161
      sa\u0107u da te podsetim!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228173
  - m_Id: 396604921463541775
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Daj malo aktiviraj te atrofirane
      mi\u0161i\u0107e..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228174
  - m_Id: 396604921463541774
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Peskom?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228175
  - m_Id: 396604921463541773
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Izgleda\u0161 mi \u017Egoljavo
      za jednog indijanca\u2026"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228176
  - m_Id: 396604921463541772
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: [smoothWave]mRRRRRRRRRnjau!!![/smoothWave]"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228177
  - m_Id: 396604921463541771
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Malo sam po\u010Deo da pumpam
      u trtani i pijem ovaj naturalni soki\u0107!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228178
  - m_Id: 396604921463541770
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Aaa, ma\u010Doru, el to merka\u0161
      moje mu\u017Eevne MA\u010CO mi\u0161i\u0107e?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228179
  - m_Id: 396604921463541769
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u0160ta je??"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228180
  - m_Id: 396604921463541768
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u0160ta me gleda\u0161 ko
      tele u \u0161arena vrata?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228181
  - m_Id: 396604921463541767
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Zr-Zar ne vidi\u0161 da radim
      ovde, V[smoothWave]aaaaaaaaa[/smoothWave]\u017Ean poso..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228182
  - m_Id: 396604921463541766
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ono kao drugar, \u0161ta se
      trezni\u0161 u-u mojoj rupetini, aa?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228183
  - m_Id: 396604921463541765
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Ovde dole bato!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228184
  - m_Id: 396604921463541764
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: [normalWave]EeEeEeEeEeE!!![/normalWave]"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228185
  - m_Id: 396604921463541763
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: Alo Kur\u010Davela!"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228186
  - m_Id: 396604921463541762
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: *psst*"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228187
  - m_Id: 396604921463541761
    m_Localized: "Indijanac_D\u017Eons: ..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228188
  - m_Id: 396604921463541760
    m_Localized: "BOB: *Klikni da nastavi\u0161*"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228189
  - m_Id: 396605204386123776
    m_Localized: Ok...
    m_Metadata:
      m_Items:
      - rid: 8448310131942228190
  - m_Id: 396605204386123777
    m_Localized: Ok...
    m_Metadata:
      m_Items:
      - rid: 8448310131942228191
  - m_Id: 396605204386123778
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: \u0160ta treba tebra? Ja kao
      zaboravio da te pitam od ovolkog uzbu\u0111enja."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228192
  - m_Id: 396605204386123779
    m_Localized: "Indijanac_D\u017Eons: ne\u0107e da bude blizu..."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228193
  - m_Id: 396605204386123780
    m_Localized: Ok...
    m_Metadata:
      m_Items:
      - rid: 8448310131942228194
  - m_Id: 396605204386123781
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: ok, braci?"
    m_Metadata:
      m_Items:
      - rid: 8448310131942228195
  - m_Id: 396605204386123782
    m_Localized: "Ludi_ma\u010Dor_za_stare_ku\u0107e: ono drvo izgleda ako dobro
      mesto de da zabode\u0161 sekiru."
    m_Metadata:
      m_Items:
      - rid: 8448310131942228196
